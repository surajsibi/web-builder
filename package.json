{
  "name": "web-builder",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "benchmark:commands": "vitest bench src/builder/commands/__benchmarks__/execute-command.bench.ts --run --environment node --maxWorkers 1 --no-file-parallelism",
    "benchmark:drag": "vitest bench src/builder/ui/__benchmarks__/drag-and-drop.bench.ts --run --environment node --maxWorkers 1 --no-file-parallelism",
    "benchmark:history": "vitest bench src/builder/store/__benchmarks__/history-retention.bench.ts --run --environment node --maxWorkers 1 --no-file-parallelism",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dnd-kit/react": "0.5.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "30.0.1",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.10"
  }
}
